{
  "name": "ha-frigate-vision",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build:brand": "node scripts/build-brand.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "check:brand": "node scripts/build-brand.mjs --check",
    "check:vendor": "node scripts/build-vendor.mjs --check",
    "check": "npm run check:brand && npm run check:vendor && node --check custom_components/frigate_vision/frontend/frigate-vision-card.js && node --check custom_components/frigate_vision/frontend/vendor/lit-3.3.3.js && node --check custom_components/frigate_vision/frontend/vendor/hls-1.7.3.js",
    "test": "node --test tests/card/*.test.mjs",
    "test:browser": "node --test tests/card/browser-runtime.test.mjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hls.js": "1.7.3",
    "lit": "3.3.3",
    "playwright": "1.62.1",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
